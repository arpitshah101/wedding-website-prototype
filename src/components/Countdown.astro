---
interface Props {
  targetDate: string;
  title?: string;
}

const { targetDate, title = 'Countdown to the Wedding' } = Astro.props;
---

<section class="mb-4">
  <div class="flex flex-col items-center justify-center">
    <div
      class="grid grid-cols-5 gap-2 sm:gap-3"
      data-countdown
      data-target-date={targetDate}
      style="font-family: 'Playfair Display', serif;"
    >
      <div
        class="min-w-12 rounded-xl px-2 py-2 text-center sm:min-w-16 sm:px-3 sm:py-3"
      >
        <div
          data-months
          class="text-xl font-normal text-[#66535E] sm:text-xs lg:text-3xl"
        >
          00
        </div>
        <div
          class="mt-1 text-[10px] tracking-[0.2em] text-neutral-600 uppercase"
        >
          Months
        </div>
      </div>
      <div
        class="min-w-12 rounded-xl px-2 py-2 text-center sm:min-w-16 sm:px-3 sm:py-3"
      >
        <div
          data-days
          class="text-xl font-normal text-[#66535E] sm:text-xs lg:text-3xl"
        >
          00
        </div>
        <div
          class="mt-1 text-[10px] tracking-[0.2em] text-neutral-600 uppercase"
        >
          Days
        </div>
      </div>
      <div
        class="min-w-12 rounded-xl px-2 py-2 text-center sm:min-w-16 sm:px-3 sm:py-3"
      >
        <div
          data-hours
          class="text-xl font-normal text-[#66535E] sm:text-xs lg:text-3xl"
        >
          00
        </div>
        <div
          class="mt-1 text-[10px] tracking-[0.2em] text-neutral-600 uppercase"
        >
          Hours
        </div>
      </div>
      <div
        class="min-w-12 rounded-xl px-2 py-2 text-center sm:min-w-16 sm:px-3 sm:py-3"
      >
        <div
          data-minutes
          class="text-xl font-normal text-[#66535E] sm:text-xs lg:text-3xl"
        >
          00
        </div>
        <div
          class="mt-1 text-[10px] tracking-[0.2em] text-neutral-600 uppercase"
        >
          Mins
        </div>
      </div>
      <div
        class="min-w-12 rounded-xl px-2 py-2 text-center sm:min-w-16 sm:px-3 sm:py-3"
      >
        <div
          data-seconds
          class="text-xl font-normal text-[#66535E] sm:text-xs lg:text-3xl"
        >
          00
        </div>
        <div
          class="mt-1 text-[10px] tracking-[0.2em] text-neutral-600 uppercase"
        >
          Secs
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const countdown = document.querySelector(
    '[data-countdown]'
  ) as HTMLElement | null;

  if (countdown) {
    const targetDate = new Date(countdown.dataset.targetDate || '');
    const monthsEl = countdown.querySelector(
      '[data-months]'
    ) as HTMLElement | null;
    const daysEl = countdown.querySelector('[data-days]') as HTMLElement | null;
    const hoursEl = countdown.querySelector(
      '[data-hours]'
    ) as HTMLElement | null;
    const minutesEl = countdown.querySelector(
      '[data-minutes]'
    ) as HTMLElement | null;
    const secondsEl = countdown.querySelector(
      '[data-seconds]'
    ) as HTMLElement | null;

    const formatNumber = (value: number) => String(value).padStart(2, '0');

    const updateCountdown = () => {
      if (!targetDate || Number.isNaN(targetDate.getTime())) return;

      const now = new Date().getTime();
      let difference = targetDate.getTime() - now;

      if (difference <= 0) {
        if (monthsEl) monthsEl.textContent = '00';
        if (daysEl) daysEl.textContent = '00';
        if (hoursEl) hoursEl.textContent = '00';
        if (minutesEl) minutesEl.textContent = '00';
        if (secondsEl) secondsEl.textContent = '00';
        return;
      }

      const months = Math.floor(difference / (1000 * 60 * 60 * 24 * 30.44));
      difference -= months * (1000 * 60 * 60 * 24 * 30.44);
      const days = Math.floor(difference / (1000 * 60 * 60 * 24));
      difference -= days * (1000 * 60 * 60 * 24);
      const hours = Math.floor(difference / (1000 * 60 * 60));
      difference -= hours * (1000 * 60 * 60);
      const minutes = Math.floor(difference / (1000 * 60));
      difference -= minutes * (1000 * 60);
      const seconds = Math.floor(difference / 1000);

      if (monthsEl) monthsEl.textContent = formatNumber(months);
      if (daysEl) daysEl.textContent = formatNumber(days);
      if (hoursEl) hoursEl.textContent = formatNumber(hours);
      if (minutesEl) minutesEl.textContent = formatNumber(minutes);
      if (secondsEl) secondsEl.textContent = formatNumber(seconds);
    };

    updateCountdown();
    setInterval(updateCountdown, 1000);
  }
</script>
