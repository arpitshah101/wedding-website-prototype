---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import { getBasePath } from '@/utils/basePath';

const pageTitle = `Page Not Found | ${SITE.title}`;
const homeUrl = getBasePath('/');
---

<MainLayout title={pageTitle} hideNavbar={true}>
  <section
    class="grid min-h-svh place-content-center bg-[#FFF8F0] px-4 py-16 text-center"
  >
    <div class="mx-auto max-w-xl">
      <p
        class="mb-4 font-['Cinzel'] text-sm tracking-[0.35em] text-[#B8860B] uppercase"
      >
        {SITE.title}
      </p>
      <h1
        class="mb-4 font-['Playfair_Display'] text-7xl font-semibold text-[#8B6F47] sm:text-8xl"
      >
        404
      </h1>
      <h2
        class="mb-4 font-['Playfair_Display'] text-3xl font-medium text-balance text-[#5F4B32] sm:text-4xl"
      >
        This page has wandered off
      </h2>
      <p class="mb-8 text-lg text-pretty text-[#6B5A45]">
        The page you're looking for doesn't exist, but the celebration is still
        right where you left it.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={homeUrl}
          class="inline-flex items-center justify-center rounded-full bg-[#B8860B] px-6 py-3 text-sm font-semibold tracking-wide text-white transition-colors hover:bg-[#9A6F08]"
        >
          Return to Home
        </a>
        <button
          id="go-back"
          type="button"
          class="inline-flex items-center justify-center rounded-full border border-[#B8860B]/40 px-6 py-3 text-sm font-semibold tracking-wide text-[#8B6F47] transition-colors hover:bg-[#B8860B]/10"
        >
          Go Back
        </button>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const goBackButton = document.getElementById('go-back');

  goBackButton?.addEventListener('click', () => {
    history.back();
  });
</script>
