---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import Countdown from '@/components/Countdown.astro';
import weddingThemeBackground from '@images/wedding-theme-background.jpg';
import mobileBackground from '@images/mobile-background.jpg';
import ganeshMotif from '@images/ganesh-motif.svg';
import amp from '@images/amp.svg';
import RSVPButton from '@components/ui/buttons/RSVPButton.astro';
import { getBasePath } from '@/utils/basePath';

const RSVP_EMBED_URL = 'https://withjoy.com/arpit-rushita-cancun2027/rsvp';
const homePath = getBasePath('/');
---

<MainLayout>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat sm:block md:hidden"
    style={`background-image: url('${mobileBackground.src}');`}
  >
  </div>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat md:block"
    style={`background-image: url('${weddingThemeBackground.src}');`}
  >
  </div>
  <div class="relative z-10 mt-7.5 -mb-7.5 w-full flex-col lg:ml-auto">
    <div class="bg-transparent lg:bg-transparent">
      <div class="block lg:hidden">
        <div class="absolute inset-0 -z-10"></div>
      </div>

      <!-- Ganesh Motif -->
      <div
        class="flex items-center justify-center px-8 py-4 sm:px-8 sm:py-4 lg:px-10 lg:py-3"
      >
        <img
          src={ganeshMotif.src}
          alt="Ganesh motif"
          class="h-15 w-auto object-contain opacity-100 sm:h-15 lg:h-25"
        />
      </div>
      <section
        id="invitation-card"
        class="mx-[10px] my-[10px] w-[calc(100%-20px)] rounded-[28px] border bg-white/1 shadow-none backdrop-blur-xs lg:mx-auto lg:my-[10px] lg:w-1/2"
      >
        <p
          class="my-4 text-center text-sm font-normal tracking-[0.3em] text-neutral-700/80 uppercase sm:text-base"
        >
          You are cordially invited to the wedding of
        </p>
        <h1
          class="text-center text-5xl font-normal text-balance text-neutral-800 md:text-6xl md:leading-tight dark:text-neutral-200"
          style="font-family: 'Parisienne', cursive;"
        >
          Arpit
        </h1>
        <div
          class="flex items-center justify-center px-8 py-2 sm:px-8 sm:py-2 lg:px-10 lg:py-2"
        >
          <img
            src={amp.src}
            alt="AMP"
            class="h-12 w-auto object-contain opacity-100 sm:h-12 lg:h-15"
          />
        </div>
        <h1
          class="text-center text-5xl font-normal text-balance text-neutral-800 md:text-6xl md:leading-tight dark:text-neutral-200"
          style="font-family: 'Parisienne', cursive;"
        >
          Rushita
        </h1>
        <br /><br />
        <p
          class="sm:text-md text-center text-lg font-semibold tracking-[0.3em] text-neutral-700/80 uppercase"
        >
          8-11th November, 2027
        </p>
        <p
          class="mb-4 text-center text-sm font-normal tracking-[0.3em] text-neutral-700/80 uppercase sm:text-sm"
        >
          Moon Palace, Cancún, Quintana Roo, Mexico
        </p>
        <br />
        <Countdown targetDate="2027-11-08T00:00:00" />
      </section>
      <div class="mb-10 flex items-center justify-center lg:mt-50">
        <div data-rsvp-open class="cursor-pointer">
          <RSVPButton
            title="RSVP"
            url={homePath}
            fontClass="font-semibold text-base sm:text-base lg:text-4xl"
          />
        </div>
      </div>
    </div>
  </div>

  <div
    data-rsvp-modal
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/50 p-0 lg:p-4"
  >
    <div
      class="relative h-full w-full overflow-hidden bg-white shadow-2xl lg:h-[80vh] lg:w-[50vw] lg:rounded-2xl"
    >
      <button
        type="button"
        data-rsvp-close
        class="absolute top-3 right-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-xl text-neutral-800 shadow-sm"
        aria-label="Close RSVP dialog"
      >
        ×
      </button>
      <iframe
        src={RSVP_EMBED_URL}
        title="RSVP form"
        class="h-full w-full overflow-hidden border-0"
        style="scrollbar-width: none; -ms-overflow-style: none; overflow: hidden;"
      ></iframe>
    </div>
  </div>

  <script>
    const openButton = document.querySelector('[data-rsvp-open]');
    const closeButton = document.querySelector('[data-rsvp-close]');
    const modal = document.querySelector('[data-rsvp-modal]');

    if (openButton && closeButton && modal) {
      const openModal = (event: MouseEvent) => {
        event.preventDefault();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      };

      const closeModal = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      openButton.addEventListener('click', event =>
        openModal(event as MouseEvent)
      );
      closeButton.addEventListener('click', closeModal);
      modal.addEventListener('click', event => {
        if (event.target === modal) closeModal();
      });
    }
  </script>
</MainLayout>
