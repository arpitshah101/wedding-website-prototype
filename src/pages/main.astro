---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import CoupleMessageSection from '@components/sections/wedding/CoupleMessageSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from '@images/hero-image.avif';
import faqs from '@data/faqs.json';
import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import FeaturesStats from '@/components/sections/features/FeaturesStats.astro';
import Countdown from '@/components/Countdown.astro';
import weddingThemeBackground from '@images/wedding-theme-background.jpg';
import ganeshMotif from '@images/ganesh-motif.svg';
import RSVPButton from '@components/ui/buttons/RSVPButton.astro';

const avatarSrcs: Array<string> = [
  'https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
];
---

<MainLayout>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-10 bg-[#99b7bf] bg-cover bg-center bg-no-repeat"
    style={`background-image: url('${weddingThemeBackground.src}');`}
  >
  </div>
  <div class="relative min-h-screen z-10 mt-7.5 -mb-7.5 flex w-full flex-col lg:ml-auto">
    <div class="flex-auto bg-transparent lg:bg-transparent">
      <div class="block lg:hidden">
        <div class="absolute inset-0 -z-10" />
      </div>

      <!-- Ganesh Motif -->
      <section class="bg-transparent">
        <div
          class="flex items-center justify-center px-8 py-8 sm:px-8 sm:py-8 lg:px-10 lg:py-3"
        >
          <img
            src={ganeshMotif.src}
            alt="Ganesh motif"
            class="h-15 w-auto object-contain opacity-100 sm:h-15 lg:h-25"
          />
        </div>
        <Countdown targetDate="2027-11-08T00:00:00" title="" />
        <p
          class="text-center text-sm font-semibold tracking-[0.3em] text-neutral-700/80 uppercase sm:text-base"
        >
          8-11th November, 2027
        </p>
        <p class="mb-4 text-center text-sm font-normal tracking-[0.3em] text-neutral-700/80 uppercase sm:text-base lg:mb-75">
          Moon Palace, Cancún, Quintana Roo, Mexico
        </p>

      </section>
    </div>
    <div class="flex-none w-full px-4 pb-50 pt-10">
      <div class="flex items-center justify-center">
        <RSVPButton
          title="RSVP"
          url="/rsvp"
          fontClass="font-semibold text-base sm:text-base lg:text-4xl"
        />
      </div>
    </div>
  </div>
</MainLayout>
