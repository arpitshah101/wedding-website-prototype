---
import MainLayout from '@/layouts/MainLayout.astro';
import weddingThemeBackground from '@images/wedding-theme-background.jpg';
import mobileBackground from '@images/mobile-background.jpg';

const faqSections = [
  {
    title: 'Travel & Arrival',
    questions: [
      {
        question: 'Which airport should I fly into?',
        answer:
          'The nearest airport is Cancún International Airport (CUN), located approximately 15–20 minutes from Moon Palace.',
        keywords: ['airport', 'cancun', 'transport', 'arrival'],
      },
      {
        question: 'How long does it take to get from the airport to the resort?',
        answer:
          'The transfer typically takes around 15 to 30 minutes depending on traffic and which section of Moon Palace you are heading to.',
        keywords: ['hotel', 'transfer', 'transportation'],
      },
      {
        question: 'What flights are available from London, New York and India?',
        answerHtml: `
          <p><strong>London:</strong> Direct flights from London Gatwick (LGW) to Cancún (CUN) take approximately 10–11 hours; one-stop flights are also available from Heathrow and other UK airports.</p>
          <p><strong>New York:</strong> Direct flights from JFK and Newark (EWR) to Cancún (CUN) take approximately 4–5 hours.</p>
          <p><strong>India:</strong> There are no direct flights to Cancún. Most routes involve one or two connections, with total journey times typically ranging from 20–28 hours depending on your departure city and layovers.</p>
          <br/>
          <p>Here are some helpful links:</p>
          <ul class="list-inside list-disc space-y-1">
            <li><a class="text-yellow-600 underline" href="https://www.google.com/travel/flights?gl=GB&hl=en-GB" target="_blank" rel="noopener noreferrer">Google Flights</a></li>
            <li><a class="text-yellow-600 underline" href="https://www.skyscanner.net/" target="_blank" rel="noopener noreferrer">Skyscanner</a></li>
            <li><a class="text-yellow-600 underline" href="https://www.expedia.co.uk/Flights?locale=en_GB&siteid=3" target="_blank" rel="noopener noreferrer">Expedia Flights</a></li>
          </ul>
        `,
        keywords: ['flights', 'london', 'new york', 'india'],
      },
      {
        question: 'Where can I find information about booking my hotel and travel?',
        answer:
          'Everything you need to know about accommodation, airport transfers, booking deadlines and travel tips can be found on our Travel & Accommodation page.',
      },
      {
        question: 'Will there be a welcome desk or check-in area?',
        answer:
          'A welcome desk will be available at the resort for guests who need assistance with entry details, transfers, or event questions.',
      },
      {
        question: 'What is the weather like in Cancún in November?',
        answerHtml: `
          <p>November is one of the best times to visit Cancún, with warm temperatures, lower humidity and plenty of sunshine. Daytime temperatures typically range from <strong>27–30°C (81–86°F)</strong>, while evenings are a little cooler at around <strong>22–24°C (72–75°F)</strong>.</p>
          <p>Although November marks the end of the rainy season, any showers are usually brief before the sunshine returns. We recommend packing lightweight clothing for the day, a light layer for the evenings, comfortable footwear, and plenty of sunscreen.</p>
        `,
      },
    ],
  },
  {
    title: 'Wedding Day Details',
    questions: [
      {
        question: 'What should I wear?',
        answer:
          "Each of our celebrations has its own dress code. Please visit our Dress Code page for outfit guidance, inspiration and recommended colours for each event.",
        keywords: ['dress code', 'attire', 'outfit', 'colors'],
      },
      {
        question: 'Will all of the wedding events take place at Moon Palace?',
        answer:
          'Yes! All of our wedding events will take place within Moon Palace Cancún. Each event will be held at a different venue across the resort, with the exact locations and timings available on our Dress Code & Schedule page.',
      },
      {
        question: 'Can dietary requirements or allergies be accommodated?',
        answer:
          'Please let us know about any dietary requirements or allergies when you RSVP.',
      },
      {
        question: 'Are children or plus ones invited?',
        answer:
          'Please refer to your invitation.',
      },
      {
        question: 'Who should I contact if I have a question?',
        answer:
          'For wedding-related questions, please feel free to contact either of us directly. If your query relates to accommodation, flights or travel arrangements, please refer to our Travel & Accommodation page.',
      },
    ],
  },
  {
    title: 'Resort & Stay',
    questions: [
      {
        question: 'What amenities are included in the resort stay?',
        answerHtml: `
          <p>The resort offers beach access, multiple dining venues, bars, pools, activities, and entertainment throughout the property along with family-friendly areas.</p>
          <p>For more information, download the Palace Resorts app: <a class="text-yellow-600 underline" href="https://apps.apple.com/us/app/palace-resorts/id1411599607" target="_blank" rel="noopener noreferrer">iOS</a> • <a class="text-yellow-600 underline" href="https://play.google.com/store/apps/details?id=com.palaceresorts.app&pli=1" target="_blank" rel="noopener noreferrer">Android</a>.</p>
        `,
      },
      {
        question: 'Is the resort all-inclusive?',
        answer:
          'Yes, the resort is designed as an all-inclusive destination, with many amenities and dining options covered in the stay package.',
      },
      {
        question: 'Are there activities for guests who want to explore beyond the resort?',
        answerHtml: `
          <p>There are several optional excursions available, including beaches, cultural tours, and excursions for guests who wish to explore.</p>
          <p>For more information, download the Palace Resorts app: <a class="text-yellow-600 underline" href="https://apps.apple.com/us/app/palace-resorts/id1411599607" target="_blank" rel="noopener noreferrer">iOS</a> • <a class="text-yellow-600 underline" href="https://play.google.com/store/apps/details?id=com.palaceresorts.app&pli=1" target="_blank" rel="noopener noreferrer">Android</a>.</p>
        `,
      },
      {
        question: 'Can I book my room directly with the resort or through another website?',
        answerHtml:
          `
          <P>Moon Palace requires all wedding guests staying at the resort to book their accommodation using our dedicated booking links. This is a resort requirement to ensure your reservation is linked to our wedding.</p>
          <br/>
          <P>If you choose to stay at another hotel, please note that Moon Palace charges non-resort guests a day pass for each day they wish to attend events at the resort. Day passes are approximately $150 USD per person, per day (subject to change and resort availability), which can add up quickly over the course of the celebrations. Our negotiated room rates are fully flexible and refundable, giving you added peace of mind should your plans change. Guests staying four nights or more will also receive complimentary round-trip airport transfers and resort credit as part of their booking.</p>
          <br/>
          <P>To avoid any additional costs and enjoy these benefits, we kindly ask that all guests book their stay using the links provided on our Travel & Accommodation page.</p>`,
      },
    ],
  },
];
---

<MainLayout title="Q&A | Wedding Website">
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat blur-[2px] sm:block md:hidden"
    style={`background-image: url('${mobileBackground.src}');`}
  ></div>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat blur-[2px] md:block"
    style={`background-image: url('${weddingThemeBackground.src}');`}
  ></div>

  <div class="relative z-10 px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-6">
      <section class="w-full rounded-[32px] border border-white/50 bg-white/80 p-6 shadow-2xl shadow-black/10 backdrop-blur-xl sm:p-6 lg:p-10">
        <div class="text-center">
          <h1
            class="mt-3 text-2xl font-normal tracking-[0.1em] text-neutral-800 md:text-2xl"
            style="font-family: 'Cinzel', serif;"
          >
            Q&A
          </h1>
        </div>

        <div class="mt-6 rounded-2xl bg-white/75 p-3 shadow-sm ring-1 ring-white/70">
          <label for="faq-search" class="sr-only">Search FAQ questions</label>
          <div class="flex items-center gap-2">
            <input
              id="faq-search"
              type="search"
              placeholder="Search questions..."
              class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-700 outline-none ring-0 placeholder:text-neutral-400 focus:border-neutral-400"
            />
            <button
              id="faq-clear"
              type="button"
              class="rounded-xl border border-neutral-300 bg-white px-3 py-2 text-xs font-medium text-neutral-700 transition hover:border-neutral-400 hover:bg-neutral-50"
            >
              Clear
            </button>
          </div>
        </div>

        <div id="faq-empty-state" class="mt-6 hidden rounded-2xl border border-neutral-200 bg-white/80 px-4 py-5 text-sm text-neutral-600">
          No questions matched your search. Try a different keyword.
        </div>

        <div class="mt-6 space-y-6">
          {
            faqSections.map((section) => (
              <div
                class="rounded-2xl border border-neutral-200/80 bg-white/70 p-4 shadow-sm sm:p-5"
                data-section-title={section.title.toLowerCase()}
              >
                <h2 class="text-lg font-semibold text-neutral-800">{section.title}</h2>
                <div class="mt-4 space-y-3" data-section>
                  {
                    section.questions.map((item) => (
                      <details
                        class="faq-item rounded-xl border border-neutral-200 bg-white/90 px-4 py-3 shadow-sm"
                        data-query={`${section.title} ${item.question} ${item.answer} ${item.keywords?.join(' ') ?? ''}`.toLowerCase()}
                      >
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-neutral-800">
                          <span>{item.question}</span>
                          <span class="shrink-0 rounded-full bg-neutral-100 px-2 py-1 text-xs text-neutral-600">
                            +
                          </span>
                        </summary>
                        {item.answerHtml ? (
                          <div class="pt-3 text-sm leading-6 text-neutral-700" set:html={item.answerHtml}></div>
                        ) : (
                          <div class="pt-3 text-sm leading-6 text-neutral-700">{item.answer}</div>
                        )}
                      </details>
                    ))
                  }
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <script>
    const searchInput = document.querySelector('#faq-search');
    const clearButton = document.querySelector('#faq-clear');
    const sections = Array.from(document.querySelectorAll('[data-section]'));
    const emptyState = document.querySelector('#faq-empty-state');

    const applySearch = (query: string) => {
      let anyVisible = false;

      sections.forEach((section) => {
        const sectionContainer = section.closest('.rounded-2xl');
        const sectionTitle = (sectionContainer as HTMLElement | null)?.dataset.sectionTitle ?? '';
        let sectionVisible = false;
        const items = Array.from(section.querySelectorAll('.faq-item'));

        items.forEach((item) => {
          const text = (item as HTMLElement).dataset.query ?? '';
          const shouldShow = !query || sectionTitle.includes(query) || text.includes(query);
          item.classList.toggle('hidden', !shouldShow);
          if (shouldShow) sectionVisible = true;
        });

        sectionContainer?.classList.toggle('hidden', !sectionVisible);
        if (sectionVisible) anyVisible = true;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', anyVisible);
      }
    };

    if (searchInput) {
      searchInput.addEventListener('input', (event) => {
        const query = (event.currentTarget as HTMLInputElement).value.trim().toLowerCase();
        applySearch(query);
      });

      clearButton?.addEventListener('click', () => {
        if (searchInput instanceof HTMLInputElement) {
          searchInput.value = '';
          applySearch('');
          searchInput.focus();
        }
      });
    }
  </script>
</MainLayout>
