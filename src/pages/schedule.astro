---
import MainLayout from '@/layouts/MainLayout.astro';
import weddingThemeBackground from '@images/wedding-theme-background.jpg';
import mobileBackground from '@images/mobile-background.jpg';
import { getBasePath } from '@/utils/basePath';

const homePath = getBasePath('/');
const nextPagePath = getBasePath('/travel-and-accommodation');

const events = [
  {
    date: '8th November 2027',
    title: 'Sangeet / Mendhi',
    label: 'Day 1',
    time: '6:00 PM - 10:00 PM',
    venue: 'Resort venue placeholder',
    dressCodeHeading: 'Sangeet & Mendhi Dress Code',
  },
  {
    date: '9th November 2027',
    title: 'Vidhi / Haldi',
    label: 'Day 2',
    time: '10:00 AM - 2:00 PM',
    venue: 'Resort venue placeholder',
    dressCodeHeading: 'Vidhi & Haldi Dress Code',
  },
  {
    date: '10th November 2027',
    title: 'Wedding Ceremony',
    label: 'Day 3',
    time: '4:00 PM - 10:00 PM',
    venue: 'Resort venue placeholder',
    dressCodeHeading: 'Wedding Ceremony Dress Code',
  },
  {
    date: '11th November 2027',
    title: 'Reception',
    label: 'Day 4',
    time: '7:00 PM - 11:00 PM',
    venue: 'Resort venue placeholder',
    dressCodeHeading: 'Reception Dress Code',
  },
];
---

<MainLayout>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat sm:block md:hidden blur-[2px]"
    style={`background-image: url('${mobileBackground.src}');`}
  ></div>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat md:block blur-[2px]"
    style={`background-image: url('${weddingThemeBackground.src}');`}
  ></div>

  <section class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[2rem] border border-white/40 bg-white/90 px-6 py-12 shadow-2xl shadow-orange-200/20 backdrop-blur-xl dark:border-neutral-700/40 dark:bg-neutral-900/85 sm:px-10 sm:py-16">
      <div class="text-center">
        <h1 class="text-3xl font-bold tracking-[0.1em] text-neutral-950 dark:text-neutral-50 md:text-4xl" style="font-family: 'Sirivennela', serif;">
          Schedule & Dress Code
        </h1>
      </div>
      <div class="relative mt-12">
        <div class="space-y-16">
          {events.map((event, index) => (
            <div class="relative flex flex-col gap-6 md:flex-row md:items-start md:gap-10">
              <div class="md:w-[6rem]">
                <div class="relative flex flex-col items-center gap-4">
                  <div id={`event-badge-${index}`} class="relative flex h-16 w-16 items-center justify-center rounded-full bg-[#D6AB3A] text-lg font-semibold text-white shadow-lg shadow-yellow-500/20">
                    <span>{event.label}</span>
                  </div>

                  {index < events.length - 1 ? (
                    <button
                      type="button"
                      class="scroll-chevron inline-flex h-11 w-11 items-center justify-center rounded-full bg-white text-neutral-700 shadow-md shadow-neutral-200 transition duration-300 hover:bg-neutral-100 dark:bg-neutral-950 dark:text-neutral-200 dark:shadow-black/20 dark:hover:bg-neutral-800"
                      data-scroll-target={`event-badge-${index + 1}`}
                      aria-label={`Scroll to ${events[index + 1].label}`}
                    >
                      <svg
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M5 7.5L10 12.5L15 7.5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                  ) : null}
                </div>
              </div>

              <div id={`event-card-${index}`} class="w-full rounded-3xl border border-neutral-200 bg-white p-8 shadow-sm transition duration-300 hover:border-yellow-300 hover:shadow-lg dark:border-neutral-700 dark:bg-neutral-950">
                <p class="text-sm font-semibold uppercase tracking-[0.35em] text-yellow-600">
                  {event.date}
                </p>
                <h2 class="mt-4 text-2xl font-semibold text-neutral-900 dark:text-neutral-100">
                  {event.title}
                </h2>
                <div class="mt-6 space-y-2 text-sm text-neutral-600 dark:text-neutral-300" style="font-family: 'Lora', serif;">
                  <p class="font-semibold text-neutral-900 dark:text-neutral-100">{event.time}</p>
                  <p>{event.venue}</p>
                </div>
                <button
                  type="button"
                  class="mt-8 inline-flex w-full items-center justify-center rounded-full bg-yellow-500 px-5 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-yellow-600 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-yellow-300"
                  aria-expanded="false"
                  data-toggle={`dress-code-${index}`}
                >
                  View Dress Code
                </button>
                <div id={`dress-code-${index}`} class="mt-6 hidden rounded-3xl border border-neutral-200 bg-neutral-50 p-6 dark:border-neutral-700 dark:bg-neutral-950">
                  <p class="text-sm font-semibold uppercase tracking-[0.35em] text-neutral-500 dark:text-neutral-400">
                    {event.dressCodeHeading}
                  </p>
                  <div class="mt-4 overflow-hidden rounded-3xl bg-gradient-to-br from-yellow-100 via-white to-yellow-100 p-6 dark:from-yellow-900/20 dark:via-neutral-900 dark:to-yellow-900/10">
                    <div class="flex h-full w-full flex-col items-center justify-center rounded-3xl border border-dashed border-yellow-300 bg-white/80 p-6 text-center shadow-sm dark:border-yellow-600 dark:bg-neutral-900/70">
                      <p class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">
                        {event.dressCodeHeading}
                      </p>
                      <p class="mt-3 text-sm leading-7 text-neutral-600 dark:text-neutral-300" style="font-family: 'Lora', serif;">
                        This preview image shows the suggested guest dress code for the celebration.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <div class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-5xl flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={homePath}
        class="inline-flex items-center justify-center rounded-full border border-white/70 bg-white/70 px-6 py-3 text-sm font-semibold tracking-[0.3em] text-neutral-800 uppercase shadow-md backdrop-blur transition hover:bg-white"
      >
        Back to Invitation
      </a>
      <a
        href={nextPagePath}
        class="inline-flex items-center justify-center rounded-full border border-white/70 bg-white/70 px-6 py-3 text-sm font-semibold tracking-[0.3em] text-neutral-800 uppercase shadow-md backdrop-blur transition hover:bg-white"
      >
        Travel & Accommodation
      </a>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleButtons = document.querySelectorAll('[data-toggle]');
      const scrollButtons = document.querySelectorAll('[data-scroll-target]');

      toggleButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.getAttribute('data-toggle');
          if (!targetId) return;

          const panel = document.getElementById(targetId);
          if (!panel) return;

          const isHidden = panel.classList.toggle('hidden');
          button.setAttribute('aria-expanded', String(!isHidden));
          button.textContent = isHidden ? 'View Dress Code' : 'Hide Dress Code';
        });
      });

      scrollButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.getAttribute('data-scroll-target');
          if (!targetId) return;

          const targetCard = document.getElementById(targetId);
          if (!targetCard) return;

          targetCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    });
  </script>
</MainLayout>
