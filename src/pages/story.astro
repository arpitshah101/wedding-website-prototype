---
import MainLayout from '@/layouts/MainLayout.astro';
import weddingThemeBackground from '@images/wedding-theme-background.jpg';
import mobileBackground from '@images/mobile-background.jpg';
import storyImageOne from '@images/hero-image.avif';
import storyImageTwo from '@images/aerial-view.avif';
import storyImageThree from '@images/blueprints-image.avif';
import storyImageFour from '@images/construction-workers.avif';
---

<MainLayout>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat sm:block md:hidden"
    style={`background-image: url('${mobileBackground.src}');`}
  />
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat md:block"
    style={`background-image: url('${weddingThemeBackground.src}');`}
  />

  <div class="relative z-10 px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-6">
      <section class="w-full rounded-[32px] border border-white/50 bg-white/40 p-4 shadow-2xl shadow-black/10 backdrop-blur-xl sm:p-4 lg:p-10">
        <div class="text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.35em] text-neutral-700/80 sm:text-base">
            Our Story
          </p>
          <h1
            class="mt-3 text-1xl font-normal tracking-[0.3em] text-neutral-800 md:text-2xl"
            style="font-family: 'Cinzel', serif;"
          >
            How We Met
          </h1>
        </div>

        <div class="mt-8">
          <div class="mx-auto mb-6 max-w-3xl overflow-hidden rounded-[14px] border border-white/70 bg-white/70 p-1 shadow-xl shadow-black/10 backdrop-blur-sm">
            <div class="relative h-[260px] overflow-hidden rounded-[11px] sm:h-[340px] lg:h-[420px]">
              <div class="carousel-track flex h-full transition-transform duration-700 ease-in-out">
                <img src={storyImageOne.src} alt="The couple together" class="h-full w-full shrink-0 object-cover" />
                <img src={storyImageTwo.src} alt="A scenic moment together" class="h-full w-full shrink-0 object-cover" />
                <img src={storyImageThree.src} alt="A shared creative moment" class="h-full w-full shrink-0 object-cover" />
                <img src={storyImageFour.src} alt="A joyful memory" class="h-full w-full shrink-0 object-cover" />
              </div>
            </div>
          </div>

          <div class="space-y-4 text-base leading-8 text-neutral-700">
            <p>
              Insert our story here
            </p>
          </div>
        </div>
      </section>

      <a
        href="/"
        class="inline-flex items-center justify-center rounded-full border border-white/70 bg-white/70 px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-neutral-800 shadow-md backdrop-blur transition hover:bg-white"
      >
        Back to Invitation
      </a>
    </div>
  </div>

  <script>
    const track = document.querySelector('.carousel-track');
    if (track) {
      const slides = Array.from(track.children);
      let currentIndex = 0;

      const showSlide = (index: number) => {
        const offset = index * -100;
        track.setAttribute('style', `transform: translateX(${offset}%);`);
      };

      const nextSlide = () => {
        currentIndex = (currentIndex + 1) % slides.length;
        showSlide(currentIndex);
      };

      setInterval(nextSlide, 5000);
      showSlide(0);
    }
  </script>
</MainLayout>
