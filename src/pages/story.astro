---
import MainLayout from '@/layouts/MainLayout.astro';
import weddingThemeBackground from '@images/wedding-theme-background.jpg';
import mobileBackground from '@images/mobile-background.jpg';
import storyImageOne from '@images/hero-image.avif';
import storyImageTwo from '@images/aerial-view.avif';
import storyImageThree from '@images/blueprints-image.avif';
import storyImageFour from '@images/construction-workers.avif';
---

<MainLayout>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat blur-[2px] sm:block md:hidden"
    style={`background-image: url('${mobileBackground.src}');`}
  >
  </div>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat blur-[2px] md:block"
    style={`background-image: url('${weddingThemeBackground.src}');`}
  >
  </div>

  <div class="relative z-10 px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-6">
      <section
        class="w-full rounded-[32px] border border-white/50 bg-white/40 p-4 shadow-2xl shadow-black/10 backdrop-blur-xl sm:p-4 lg:p-10"
      >
        <div class="text-center">
          <h6
            class="mt-3 text-2xl font-normal tracking-[0.1em] text-neutral-800 md:text-xl"
            style="font-family: 'Cinzel', serif;"
          >
            How We Met
          </h6>
        </div>

        <div class="mt-8">
          <div
            class="mx-auto mb-6 max-w-3xl overflow-hidden rounded-[14px] border border-white/70 bg-white/70 p-1 shadow-xl shadow-black/10 backdrop-blur-sm"
          >
            <div
              class="relative h-[260px] overflow-hidden rounded-[11px] sm:h-[340px] lg:h-[420px]"
            >
              <div
                class="carousel-track flex h-full transition-transform duration-700 ease-in-out"
              >
                <img
                  src={storyImageOne.src}
                  alt="The couple together"
                  class="h-full w-full shrink-0 object-cover"
                />
                <img
                  src={storyImageTwo.src}
                  alt="A scenic moment together"
                  class="h-full w-full shrink-0 object-cover"
                />
                <img
                  src={storyImageThree.src}
                  alt="A shared creative moment"
                  class="h-full w-full shrink-0 object-cover"
                />
                <img
                  src={storyImageFour.src}
                  alt="A joyful memory"
                  class="h-full w-full shrink-0 object-cover"
                />
              </div>
            </div>
          </div>

          <div class="space-y-4 text-base leading-8 text-neutral-700">
            <p>
              If you'd asked either of us in September 2024 whether we'd be
              planning a wedding, we'd probably have laughed… and then
              complained about online dating.
            </p>

            <p>
              Then, Arpit changed his Hinge location to London. We matched the
              very next day and immediately discovered a shared love for Mario
              Kart, long walks, and a highly competitive streak over table
              tennis (or ping pong, depending on who you ask—the debate is still
              ongoing). Just like us matching on Hinge, our meeting also felt
              serendipitous. Within a day of matching, an opportunity popped up
              for Arpit to travel to London for work and we set a date for
              November 2024.
            </p>

            <p>
              Our first date at Zizzi proved we got along just as well in
              person, and countless flights and a trip to Paris later, things
              became official. We navigated the time difference with long video
              calls and daily commutes spent playing our favorite puzzle game,
              Squaredle. Fast forward to November 2025: during a romantic horse
              and carriage ride through Windsor, Arpit proposed using a custom
              version of Squaredle he built just for the occasion to reveal a
              special message when Rushita opened it - "Rushi, will you marry
              me?"
            </p>

            <p>
              The 2 possible answers were "Yes or Absolutely Yes." Thankfully,
              Rushita chose correctly!
            </p>

            <p>
              November has always been our milestone month, so it only felt
              right to celebrate our Indian wedding then, too—this time
              somewhere a lot warmer. We can't wait to make even more memories
              with you all in Mexico!
            </p>
          </div>
        </div>
      </section>

      <a
        href="/"
        class="inline-flex items-center justify-center rounded-full border border-white/70 bg-white/70 px-6 py-3 text-sm font-semibold tracking-[0.3em] text-neutral-800 uppercase shadow-md backdrop-blur transition hover:bg-white"
      >
        Back to Invitation
      </a>
    </div>
  </div>

  <script>
    const track = document.querySelector('.carousel-track');
    if (track) {
      const slides = Array.from(track.children);
      let currentIndex = 0;

      const showSlide = (index: number) => {
        const offset = index * -100;
        track.setAttribute('style', `transform: translateX(${offset}%);`);
      };

      const nextSlide = () => {
        currentIndex = (currentIndex + 1) % slides.length;
        showSlide(currentIndex);
      };

      setInterval(nextSlide, 5000);
      showSlide(0);
    }
  </script>
</MainLayout>
