---
import MainLayout from '@/layouts/MainLayout.astro';
import weddingThemeBackground from '@images/wedding-theme-background.jpg';
import mobileBackground from '@images/mobile-background.jpg';
---

<MainLayout>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat blur-[2px] sm:block md:hidden"
    style={`background-image: url('${mobileBackground.src}');`}
  ></div>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat blur-[2px] md:block"
    style={`background-image: url('${weddingThemeBackground.src}');`}
  ></div>

  <div class="relative z-10 px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-6">
      <section class="w-full rounded-[32px] border border-white/50 bg-white/80 p-6 shadow-2xl shadow-black/10 backdrop-blur-xl sm:p-6 lg:p-10">
        <div class="text-center">
          <h1 class="mt-3 text-2xl font-normal tracking-[0.1em] text-neutral-800 md:text-2xl" style="font-family: 'Cinzel', serif;">Things to do</h1>
        </div>

        <div class="mt-6 space-y-6 text-base leading-7 text-neutral-700">
          <div>
            <h2 class="text-lg font-semibold">About Moon Palace Cancún</h2>
            <p class="mt-2">
              Our wedding will take place at <strong>Moon Palace Cancún</strong>, an all-inclusive beachfront resort located around 15 minutes from Cancún International Airport. The resort is made up of three connected sections—<strong>Nizuc, Sunrise and The Grand</strong>—giving guests access to a wide selection of restaurants, pools, bars and activities throughout the property.
            </p>
            <p class="mt-2">
              Whether you're looking to unwind by the beach, spend time with family, or turn the trip into a holiday, there's plenty to enjoy during your stay.
            </p>
          </div>

          <div>
            <h3 class="text-md font-semibold">Things to Do</h3>
            <ul class="mt-3 space-y-2">
              <li>🏖️ Relax on the beach or by one of the many pools</li>
              <li>🍽️ Dine at over 20 restaurants and bars, including Indian cuisine</li>
              <li>💆 Visit the spa or play a round of golf*</li>
              <li>🎳 Enjoy the bowling alley, arcade, water park and sports facilities</li>
              <li>🎭 Watch live entertainment and evening shows</li>
              <li>💪 Make use of the fitness centre and daily activities</li>
              <li>🍹 Unwind with a cocktail at one of the many bars</li>
              <li>🌅 Take a stroll along the beachfront at sunset</li>
            </ul>
          </div>

          <div>
            <h3 class="text-md font-semibold">Excursions</h3>
            <p class="mt-3">If you'd like to explore beyond the resort, there are plenty of popular day trips available:</p>
            <ul class="mt-3 space-y-2">
              <li>⛵ <strong>Isla Mujeres</strong> – A picturesque island known for its beaches, snorkelling and relaxed atmosphere.</li>
              <li>🏛️ <strong>Chichén Itzá</strong> – One of the New Seven Wonders of the World and Mexico's most famous Mayan archaeological site.</li>
              <li>💧 <strong>Cenotes</strong> – Natural freshwater sinkholes perfect for swimming and snorkelling.</li>
              <li>🐠 <strong>Snorkelling & Catamaran Tours</strong> – Explore the Caribbean Sea and nearby coral reefs.</li>
              <li>🌆 <strong>Cancún Hotel Zone</strong> – Visit local shops, restaurants and nightlife just a short drive away.</li>
            </ul>
            <p class="mt-3 text-sm italic">*Some resort activities and all excursions are available at an additional cost.</p>
          </div>

        </div>
      </section>
    </div>
  </div>
</MainLayout>
