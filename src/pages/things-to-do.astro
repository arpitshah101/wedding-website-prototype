---
import MainLayout from '@/layouts/MainLayout.astro';
import weddingThemeBackground from '@images/wedding-theme-background.jpg';
import mobileBackground from '@images/mobile-background.jpg';
import { getBasePath } from '@/utils/basePath';
import appStoreBadge from '@images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg';
import googlePlayBadge from '@images/GetItOnGooglePlay_Badge_Web_color_English.svg';

const homePath = getBasePath('/');
const nextPagePath = getBasePath('/q-and-a');
---

<MainLayout>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat blur-[2px] sm:block md:hidden"
    style={`background-image: url('${mobileBackground.src}');`}
  >
  </div>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat blur-[2px] md:block"
    style={`background-image: url('${weddingThemeBackground.src}');`}
  >
  </div>

  <div class="relative z-10 px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-6">
      <section
        class="w-full rounded-[32px] border border-white/50 bg-white/80 p-6 shadow-2xl shadow-black/10 backdrop-blur-xl sm:p-6 lg:p-10"
      >
        <div class="text-center">
          <h1
            class="mt-3 text-3xl font-bold tracking-[0.1em] text-neutral-800 md:text-4xl"
            style="font-family: 'Sirivennela', serif;"
          >
            Things to do
          </h1>
        </div>

        <div
          class="mt-6 space-y-6 text-base leading-7 text-neutral-700"
          style="font-family: 'Lora', serif;"
        >
          <div class="text-center">
            <p class="mt-2">
              <strong>Moon Palace Cancún</strong> is made up of three connected sections—<strong
                >Nizuc, Sunrise and The Grand</strong
              >—giving guests access to a wide selection of restaurants, pools,
              bars and activities throughout the property.
            </p>
            <p class="mt-2">
              Whether you're looking to unwind by the beach, spend time with
              family, or turn the trip into a holiday, there's plenty to enjoy
              during your stay.
            </p>
          </div>

          <div>
            <h3 class="text-md text-center font-semibold">Things to Do</h3>
            <ul class="mt-3 space-y-2">
              <li>🏖️ Relax on the beach or by one of the many pools</li>
              <li>
                🍽️ Dine at over 20 restaurants and bars, including Indian
                cuisine
              </li>
              <li>💆 Visit the spa or play a round of golf*</li>
              <li>
                🎳 Enjoy the bowling alley, arcade, water park and sports
                facilities
              </li>
              <li>🎭 Watch live entertainment and evening shows</li>
              <li>💪 Make use of the fitness centre and daily activities</li>
              <li>🍹 Unwind with a cocktail at one of the many bars</li>
              <li>🌅 Take a stroll along the beachfront at sunset</li>
            </ul>
          </div>

          <div>
            <h3 class="text-md text-center font-semibold">Excursions*</h3>
            <p class="mt-3">
              If you'd like to explore beyond the resort, there are plenty of
              popular day trips available:
            </p>
            <ul class="mt-3 space-y-2">
              <li>
                ⛵ <strong>Isla Mujeres</strong> – A picturesque island known for
                its beaches, snorkelling and relaxed atmosphere.
              </li>
              <li>
                🏛️ <strong>Chichén Itzá</strong> – One of the New Seven Wonders of
                the World and Mexico's most famous Mayan archaeological site.
              </li>
              <li>
                💧 <strong>Cenotes</strong> – Natural freshwater sinkholes perfect
                for swimming and snorkelling.
              </li>
              <li>
                🐠 <strong>Snorkelling & Catamaran Tours</strong> – Explore the Caribbean
                Sea and nearby coral reefs.
              </li>
              <li>
                🌆 <strong>Cancún Hotel Zone</strong> – Visit local shops, restaurants
                and nightlife just a short drive away.
              </li>
            </ul>
            <p class="mt-3 text-sm italic">
              *Some resort activities and all excursions are available at an
              additional cost.
            </p>
          </div>

          <div
            class="mt-8 rounded-3xl border border-neutral-200/80 bg-neutral-50/80 p-5 text-base leading-7 text-neutral-700"
            style="font-family: 'Lora', serif;"
          >
            <p class="font-semibold">
              Download the Palace Resorts app to view resort amenities, request
              services, book restaurants, and navigate the resort:
            </p>
            <div
              class="mt-4 flex w-full flex-col items-center gap-3 sm:flex-row sm:items-center sm:justify-center"
            >
              <a
                href="https://apps.apple.com/us/app/palace-resorts/id1411599607"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Download on the App Store"
              >
                <img
                  src={appStoreBadge.src}
                  alt="Download on the App Store"
                  class="h-12 w-auto rounded-lg"
                />
              </a>
              <a
                href="https://play.google.com/store/apps/details?id=com.palaceresorts.app&pli=1"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Get it on Google Play"
              >
                <img
                  src={googlePlayBadge.src}
                  alt="Get it on Google Play"
                  class="h-12 w-auto rounded-lg"
                />
              </a>
            </div>
          </div>
        </div>
      </section>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href={homePath}
          class="inline-flex items-center justify-center rounded-full border border-white/70 bg-white/70 px-6 py-3 text-sm font-semibold tracking-[0.3em] text-neutral-800 uppercase shadow-md backdrop-blur transition hover:bg-white"
        >
          Back to Invitation
        </a>
        <a
          href={nextPagePath}
          class="inline-flex items-center justify-center rounded-full border border-white/70 bg-white/70 px-6 py-3 text-sm font-semibold tracking-[0.3em] text-neutral-800 uppercase shadow-md backdrop-blur transition hover:bg-white"
        >
          Q&A
        </a>
      </div>
    </div>
  </div>
</MainLayout>
