---
import MainLayout from '@/layouts/MainLayout.astro';
import weddingThemeBackground from '@images/wedding-theme-background.jpg';
import mobileBackground from '@images/mobile-background.jpg';
import { getBasePath } from '@/utils/basePath';
import travelImageAgra from '@images/Moon Palace/agra.avif';
import travelImageAgra2 from '@images/Moon Palace/agra 2.avif';
import travelImageArielView from '@images/Moon Palace/ariel view.avif';
import travelImageBalcony from '@images/Moon Palace/balcony.webp';
import travelImageBeach from '@images/Moon Palace/beach.webp';
import travelImageGarden from '@images/Moon Palace/garden.avif';
import travelImageHammock from '@images/Moon Palace/hammock.webp';
import travelImageLounge from '@images/Moon Palace/lounge.webp';
import travelImageRoom from '@images/Moon Palace/room.webp';
import travelImageThai from '@images/Moon Palace/thai.webp';

const homePath = getBasePath('/');
const nextPagePath = getBasePath('/things-to-do');
const destawedUrl = 'https://www.destawed.com/couples/rushita-arpit';
const coupleMessage = `
  <div class="space-y-4 text-base leading-7 text-neutral-700">
    <p>
  We’re so excited to celebrate this next chapter with you in Mexico and can’t wait to spend an unforgettable week with our favourite people.
</p>
<p>
  We wanted our wedding to be more than just one day, but a chance for everyone to enjoy a relaxing getaway together. That’s why we chose Moon Palace Cancun—an all-inclusive resort where you can simply arrive, unwind, and enjoy great food, activities, and time with family and friends.
</p>
<p>
  You’ll find everything you need on our website, including travel information and what to expect. We’ve also partnered with <b><i>Destawed</i></b> to manage our resort room block and make booking your stay as easy as possible. If you have any travel-related questions, please visit the Destawed page and contact the Account Manager listed there.
</p>
<p>
  Thank you for all your love and support—we can’t wait to celebrate with you in the sunshine in November 2027! ☀️🤍
</p>
  </div>
`;
---

<MainLayout>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat blur-[2px] sm:block md:hidden"
    style={`background-image: url('${mobileBackground.src}');`}
  ></div>
  <div
    aria-hidden="true"
    class="fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat blur-[2px] md:block"
    style={`background-image: url('${weddingThemeBackground.src}');`}
  ></div>

  <div class="relative z-10 px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-6">
      <section class="w-full rounded-[32px] border border-white/50 bg-white/80 p-6 shadow-2xl shadow-black/10 backdrop-blur-xl sm:p-6 lg:p-10">
        <div class="text-center">
          <h1
            class="mt-3 text-2xl font-normal tracking-[0.1em] text-neutral-800 md:text-2xl"
            style="font-family: 'Cinzel', serif;"
          >
            Travel & Accommodation
          </h1>
        </div>

        <div class="mt-8 mx-auto max-w-4xl overflow-hidden rounded-[28px] border border-white/70 bg-white/90 shadow-xl shadow-black/10">
          <div class="relative aspect-[16/9] overflow-hidden rounded-[26px]">
            <div class="carousel-track flex h-full transition-transform duration-700 ease-in-out">
              <img src={travelImageArielView.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageBeach.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageGarden.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageRoom.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageBalcony.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageHammock.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageAgra.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageAgra2.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageThai.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageLounge.src} class="h-full w-full shrink-0 object-cover" />
            </div>
          </div>
        </div>

        <div class="mt-8 space-y-6">
          <div>
            <h2 class="text-lg font-semibold text-neutral-900">A note from the couple</h2>
            <div class="mt-4" set:html={coupleMessage} />
          </div>

          <div class="mt-8 flex justify-center">
            <a
              href={destawedUrl}
              rel="noreferrer"
              class="inline-flex items-center justify-center rounded-full border border-[#D6AB3A] bg-white/90 px-6 py-3 text-center text-sm font-semibold text-[#D6AB3A] shadow-none backdrop-blur-sm transition duration-200 hover:border-white/20 hover:bg-white/50 hover:text-[#e0be63]"
            >
                Book Your Stay
            </a>
          </div>
        </div>
      </section>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href={homePath}
          class="inline-flex items-center justify-center rounded-full border border-white/70 bg-white/70 px-6 py-3 text-sm font-semibold tracking-[0.3em] text-neutral-800 uppercase shadow-md backdrop-blur transition hover:bg-white"
        >
          Back to Invitation
        </a>
        <a
          href={nextPagePath}
          class="inline-flex items-center justify-center rounded-full border border-white/70 bg-white/70 px-6 py-3 text-sm font-semibold tracking-[0.3em] text-neutral-800 uppercase shadow-md backdrop-blur transition hover:bg-white"
        >
          Things to Do
        </a>
      </div>
    </div>
  </div>

  <script>
    const track = document.querySelector('.carousel-track');
    if (track) {
      const slides = Array.from(track.children);
      let currentIndex = 0;

      const showSlide = (index: number) => {
        const offset = index * -100;
        track.setAttribute('style', `transform: translateX(${offset}%);`);
      };

      const nextSlide = () => {
        currentIndex = (currentIndex + 1) % slides.length;
        showSlide(currentIndex);
      };

      setInterval(nextSlide, 5000);
      showSlide(0);
    }
  </script>
</MainLayout>
