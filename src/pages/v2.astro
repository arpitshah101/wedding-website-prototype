  <script>
    const openButton = document.querySelector('[data-rsvp-open]');
    const closeButton = document.querySelector('[data-rsvp-close]');
    const modal = document.querySelector('[data-rsvp-modal]');

    if (openButton && closeButton && modal) {
      const openModal = (event: MouseEvent) => {
        event.preventDefault();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      };

      const closeModal = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      openButton.addEventListener('click', event =>
        openModal(event as MouseEvent)
      );
      closeButton.addEventListener('click', closeModal);
      modal.addEventListener('click', event => {
        if (event.target === modal) closeModal();
      });
    }

    const dresscodeOpenButtons = Array.from(
      document.querySelectorAll('[data-dresscode-open]')
    );
    const dresscodeModals = Array.from(
      document.querySelectorAll('[data-dresscode-modal]')
    );

    const closeDresscode = (modal: Element) => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      const anyOpen = dresscodeModals.some(
        m => !m.classList.contains('hidden')
      );
      if (!anyOpen) document.body.style.overflow = '';
    };

    dresscodeOpenButtons.forEach(button => {
      const index = button.getAttribute('data-dresscode-open');
      if (index == null) return;
      button.addEventListener('click', event => {
        event.preventDefault();
        const modal = dresscodeModals.find(
          m => m.getAttribute('data-dresscode-modal') === index
        );
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });
    });

    dresscodeModals.forEach(modal => {
      modal
        .querySelector('[data-dresscode-close]')
        ?.addEventListener('click', () => closeDresscode(modal));
      modal.addEventListener('click', event => {
        if (event.target === modal) closeDresscode(modal);
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') closeDresscode(modal);
      });
    });

    const searchInput = document.querySelector('#faq-search');
    const clearButton = document.querySelector('#faq-clear');
    const sections = Array.from(document.querySelectorAll('[data-section]'));
    const emptyState = document.querySelector('#faq-empty-state');

    const applySearch = (query: string) => {
      let anyVisible = false;

      sections.forEach(section => {
        const sectionContainer = section.closest('.rounded-2xl');
        const sectionTitle =
          (sectionContainer as HTMLElement | null)?.dataset.sectionTitle ?? '';
        let sectionVisible = false;
        const items = Array.from(section.querySelectorAll('.faq-item'));

        items.forEach(item => {
          const text = (item as HTMLElement).dataset.query ?? '';
          const shouldShow =
            !query || sectionTitle.includes(query) || text.includes(query);
          item.classList.toggle('hidden', !shouldShow);
          if (shouldShow) sectionVisible = true;
        });

        sectionContainer?.classList.toggle('hidden', !sectionVisible);
        if (sectionVisible) anyVisible = true;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', anyVisible);
      }
    };

    if (searchInput) {
      searchInput.addEventListener('input', event => {
        const query = (event.currentTarget as HTMLInputElement).value
          .trim()
          .toLowerCase();
        applySearch(query);
      });

      clearButton?.addEventListener('click', () => {
        if (searchInput instanceof HTMLInputElement) {
          searchInput.value = '';
          applySearch('');
          searchInput.focus();
        }
      });
    }

    const carousels = document.querySelectorAll('.carousel-track');
    carousels.forEach(track => {
      const slides = Array.from(track.children);
      if (!slides.length) return;
      let currentIndex = 0;
      const showSlide = (index: number) => {
        const offset = index * -100;
        track.setAttribute('style', `transform: translateX(${offset}%);`);
      };
      const nextSlide = () => {
        currentIndex = (currentIndex + 1) % slides.length;
        showSlide(currentIndex);
      };
      setInterval(nextSlide, 5000);
      showSlide(0);
    });
  </script>
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    gsap.from('#v2-travel-content', {
      autoAlpha: 0,
      y: 50,
      duration: 1,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#v2-travel-content',
        start: 'top 80%',
        once: true,
      },
    });

    import { animate } from 'animejs';
    {
      const ganesh = document.getElementById('intro-ganesh');
      const line1 = document.getElementById('v2-text-line1');
      const line2 = document.getElementById('v2-text-line2');
      const line2Desktop = document.getElementById('v2-text-line2-desktop');
      const line3Desktop = document.getElementById('v2-text-line3-desktop');
      const watercolor = document.getElementById('v2-watercolor');
      const details = document.getElementById('v2-details');
      if (ganesh && line1 && line2 && watercolor && details) {
        const gRect = ganesh.getBoundingClientRect();
        const ganeshCenter = gRect.top + gRect.height / 2;
        const viewportCenter = window.innerHeight / 2;
        const centerOffset = viewportCenter - ganeshCenter;
        ganesh.style.transform = `translateY(${centerOffset}px)`;
        ganesh.style.opacity = '1';
        ganesh.style.willChange = 'transform';
        animate(ganesh, {
          translateY: { from: centerOffset, to: 0 },
          duration: 2400,
          ease: 'outCubic',
          complete: () => {
            ganesh.style.willChange = '';
          },
        });
        setTimeout(() => {
          animate(line1, {
            opacity: { from: 0, to: 1 },
            duration: 1200,
            ease: 'outCubic',
          });
          animate(line2, {
            opacity: { from: 0, to: 1 },
            duration: 1200,
            ease: 'outCubic',
          });
          if (line2Desktop) {
            animate(line2Desktop, {
              opacity: { from: 0, to: 1 },
              duration: 1200,
              ease: 'outCubic',
            });
          }
          if (line3Desktop) {
            animate(line3Desktop, {
              opacity: { from: 0, to: 1 },
              duration: 1200,
              ease: 'outCubic',
            });
          }
        }, 2400);
        setTimeout(() => {
          animate(watercolor, {
            opacity: { from: 0, to: 1 },
            duration: 1300,
            ease: 'outCubic',
          });
        }, 3700);
        setTimeout(() => {
          animate(details, {
            opacity: { from: 0, to: 1 },
            duration: 1300,
            ease: 'outCubic',
          });
        }, 5100);
      }
    }
  </script>
  <script>
    type LenisLike = {
      scrollTo: (
        target: string | number | HTMLElement,
        options?: {
          offset?: number;
          duration?: number;
          immediate?: boolean;
          lock?: boolean;
          force?: boolean;
          onComplete?: () => void;
        }
      ) => void;
    };

    declare global {
      interface Window {
        lenisScroll?: LenisLike;
      }
    }

    const toggle = document.getElementById('nav-toggle');
    const links = document.getElementById('nav-links');
    const iconOpen = document.getElementById('nav-icon-open');
    const iconClose = document.getElementById('nav-icon-close');
    if (toggle && links) {
      toggle.addEventListener('click', () => {
        links.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
      });
      links.querySelectorAll('[data-section-link]').forEach(link => {
        link.addEventListener('click', event => {
          const href = link.getAttribute('href');
          if (href?.startsWith('#')) {
            event.preventDefault();
            if (window.innerWidth < 640) {
              links.classList.add('hidden');
              iconOpen?.classList.remove('hidden');
              iconClose?.classList.add('hidden');
            }
            const target = document.querySelector(href);
            const headerHeight =
              document.querySelector('header.fixed')?.getBoundingClientRect()
                .height ?? 0;
            const targetTop =
              (target?.getBoundingClientRect().top ?? 0) + window.scrollY;
            const scrollTop = Math.max(0, targetTop - headerHeight - 12);
            const lenis = window.lenisScroll;
            if (lenis) {
              lenis.scrollTo(scrollTop);
            } else {
              window.scrollTo({ top: scrollTop, behavior: 'smooth' });
            }
          }
        });
      });
    }
  </script>
  <style>
    .venue-fade {
      --fade-width: 100%;
      --fade-height: 100%;
      --fade-start: 100%;
      --fade-end: 100%;
      mask-image: radial-gradient(
        ellipse var(--fade-width) var(--fade-height) at center,
        black var(--fade-start),
        transparent var(--fade-end)
      );
      -webkit-mask-image: radial-gradient(
        ellipse var(--fade-width) var(--fade-height) at center,
        black var(--fade-start),
        transparent var(--fade-end)
      );
    }
  </style>
</MainLayout>
