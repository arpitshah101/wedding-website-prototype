const coupleMessage = `
  <div class="space-y-4 text-center text-base leading-7 text-[#2D2D2D]/70" style="font-family: 'Lora', serif;">
    <p>
  We’re so excited to celebrate this next chapter with you in Mexico and can’t wait to spend an unforgettable week with our favourite people.
</p>
<p>
  We wanted our wedding to be more than just one day, but a chance for everyone to enjoy a relaxing getaway together. That’s why we chose Moon Palace Cancun—an all-inclusive resort where you can simply arrive, unwind, and enjoy great food, activities, and time with family and friends.
</p>
<p>
  You’ll find everything you need on our website, including travel information and what to expect. We’ve also partnered with <b><i>Destawed</i></b> to manage our resort room block and make booking your stay as easy as possible. If you have any travel-related questions, please visit the Destawed page and contact the Account Manager listed there.
</p>
<p>
  Thank you for all your love and support—we can’t wait to celebrate with you in the sunshine in November 2027! ☀️🤍
</p>
  </div>
`;
---

<MainLayout title="Wedding Website" hideNavbar={true}>
  <header
    class="fixed inset-x-0 top-0 z-50 w-full border-b border-[#2D2D2D]/10 bg-[#FDFBF7]"
  >
    <div
      class="mx-auto flex max-w-6xl items-center justify-between px-4 py-1 sm:px-6"
    >
      <div class="flex items-center gap-2 sm:hidden">
        <img
          src={logo.src}
          alt="Arpit & Rushita monogram"
          class="h-11 w-auto"
        />
      </div>
      <button
        id="nav-toggle"
        type="button"
        class="ml-auto flex h-8 w-8 items-center justify-center text-[#2D2D2D] sm:hidden"
        aria-label="Toggle navigation"
      >
        <svg
          id="nav-icon-open"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path></svg
        >
        <svg
          id="nav-icon-close"
          class="hidden h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18 18 6M6 6l12 12"></path></svg
        >
      </button>
    </div>
    <nav
      id="nav-links"
      class="hidden flex-col divide-y divide-[#2D2D2D]/10 border-t border-[#2D2D2D]/10 sm:flex sm:flex-row sm:divide-x sm:divide-y-0 sm:border-t-0"
      aria-label="Global"
    >
      {
        sectionNavItems.map(link => (
          <a
            href={link.href}
            data-section-link
            class="flex flex-1 items-center justify-center px-3 py-3 text-center text-sm tracking-[0.08em] text-[#2D2D2D] transition-colors hover:bg-[#2D2D2D]/5 sm:px-4 sm:py-4"
            style="font-family: 'Playfair Display', serif;"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </header>
  <div
    class="relative z-10"
    style="background-color: #FDFBF7; background-image: url('${backgroundTexture.src}'); background-repeat: repeat; background-size: 600px 600px;"
  >
    <section
      id="v2-home"
      class="mx-auto max-w-4xl px-2.5 pt-16 pb-8 sm:px-6 sm:pt-20 sm:pb-16 lg:py-20"
    >
      <!-- Ganesh Motif -->
      <div
        id="intro-ganesh"
        class="mb-6 text-center md:my-6"
        style="opacity: 0;"
      >
        <img
          src={ganeshMotif.src}
          alt="Ganesh motif"
          class="mx-auto h-16 w-auto object-contain sm:h-20 lg:h-20"
        />
      </div>

      <!-- Invitation Text -->
      <p
        id="v2-text-line1"
        class="mb-6 text-center text-xs tracking-[0.35em] text-[#2D2D2D]/60 sm:text-xs"
        style="opacity: 0; font-family: 'Playfair Display', serif;"
      >
        WE CORDIALLY INVITE YOU TO THE WEDDING OF
      </p>

      <!-- Couple Names + Parents -->
      <div
        id="v2-text-line2"
        class="text-center text-4xl text-[#2D2D2D] sm:hidden"
        style="opacity: 0; font-family: 'Parisienne', cursive;"
      >
        <span class="block">Arpit</span>
        <span
          class="mt-1 block text-[.7rem] tracking-[0.25em] text-[#2D2D2D]/60"
          style="font-family: 'Playfair Display', serif;"
        >
          Son of Pankaj &amp; Anjna Shah
        </span>
        <span class="mt-1 block">&amp;</span>
        <span class="block">Rushita</span>
        <span
          class="block text-[.7rem] tracking-[0.25em] text-[#2D2D2D]/60"
          style="font-family: 'Playfair Display', serif;"
        >
          Daughter of Bhavin &amp; Rekha Amin
        </span>
      </div>

      <h1
        id="v2-text-line2-desktop"
        class="hidden text-center text-4xl text-[#2D2D2D] sm:block sm:text-6xl lg:text-5xl"
        style="opacity: 0; font-family: 'Parisienne', cursive;"
      >
        Arpit &amp; Rushita
      </h1>

      <p
        id="v2-text-line3-desktop"
        class="mt-2 hidden text-center text-[.7rem] tracking-[0.25em] text-[#2D2D2D]/60 sm:block sm:text-xs"
        style="opacity: 0; font-family: 'Playfair Display', serif;"
      >
        Son of Pankaj &amp; Anjna Shah &nbsp;·&nbsp; Daughter of Bhavin &amp;
        Rekha Amin
      </p>

      <!-- Venue Artwork -->
      <div
        id="v2-watercolor"
        class="relative mx-auto mt-2 w-full overflow-hidden"
        style="opacity: 0;"
      >
        <img
          src={watercolorResort.src}
          alt="Moon Palace Cancún"
          class="venue-fade mx-auto h-auto w-full max-w-lg object-cover sm:max-w-xl md:max-w-lg"
        />
      </div>

      <!-- Details (date, events, countdown, RSVP) -->
      <div id="v2-details" style="opacity: 0;">
        <!-- Location Tag -->
        <p
          class="text-center text-base text-[#2D2D2D]/70 italic sm:text-lg"
          style="font-family: 'Playfair Display', serif;"
        >
          Moon Palace, Cancún, Quintana Roo, Mexico
        </p>

        <!-- Date Line -->
        <p
          class="mt-2 text-center text-xs font-bold tracking-[0.35em] text-[#2D2D2D]/70 sm:text-sm"
          style="font-family: 'Playfair Display', serif;"
        >
          8TH – 11TH NOVEMBER, 2027
        </p>

        <!-- Horizontal Rule -->
        <hr class="mx-auto my-2 w-24 border-t border-[#2D2D2D]/20" />

        <!-- Countdown -->
        <div class="flex justify-center">
          <Countdown targetDate="2027-11-08T00:00:00" />
        </div>

        <!-- RSVP -->
        <div class="mt-4 flex justify-center">
          <div data-rsvp-open class="cursor-pointer">
            <span
              class="inline-block border-b border-[#2D2D2D]/30 pb-0.5 text-lg tracking-[0.25em] text-[#2D2D2D] transition-colors hover:border-[#2D2D2D]/70"
              style="font-family: 'Playfair Display', serif;"
            >
              R.S.V.P.
            </span>
          </div>
        </div>
      </div>
    </section>

    <div class="flex justify-center px-4">
      <img src={divider.src} alt="" class="h-6 w-auto opacity-80 sm:h-7" />
    </div>

    <section id="v2-travel" class="w-full scroll-mt-[140px]">
      <div
        id="v2-travel-content"
        class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12"
      >
        <div class="text-center">
          <h2
            class="text-3xl font-medium text-[#2D2D2D] md:text-4xl"
            style="font-family: 'Bodoni Moda', serif;"
          >
            A Note From Us
          </h2>
          <div class="my-6 text-3xl">♥️</div>
        </div>

        <div class="mt-8 space-y-6">
          <div set:html={coupleMessage} />

          <div class="mt-8 flex justify-center">
            <a
