---
import MainLayout from '@/layouts/MainLayout.astro';
import Navbar from '@components/sections/navbar&footer/Navbar.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import Countdown from '@/components/Countdown.astro';
import RSVPButton from '@components/ui/buttons/RSVPButton.astro';
import weddingThemeBackground from '@images/wedding-theme-background.jpg';
import mobileBackground from '@images/mobile-background.jpg';
import ganeshMotif from '@images/ganesh-motif.svg';
import amp from '@images/amp.svg';
import appStoreBadge from '@images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg';
import googlePlayBadge from '@images/GetItOnGooglePlay_Badge_Web_color_English.svg';
import storyPic1 from '@images/story-pic-1.jpg';
import storyPic2 from '@images/story-pic-2.jpg';
import storyPic3 from '@images/story-pic-3.jpg';
import storyPic4 from '@images/story-pic-4.jpg';
import storyPic5 from '@images/story-pic-5.jpeg';
import storyPic6 from '@images/story-pic-6.jpg';
import storyPic7 from '@images/story-pic-7.jpg';
import storyPic8 from '@images/story-pic-8.jpg';
import storyPic9 from '@images/story-pic-9.jpg';
import travelImageAgra from '@images/Moon Palace/agra.avif';
import travelImageAgra2 from '@images/Moon Palace/agra 2.avif';
import travelImageArielView from '@images/Moon Palace/ariel view.avif';
import travelImageBalcony from '@images/Moon Palace/balcony.webp';
import travelImageBeach from '@images/Moon Palace/beach.webp';
import travelImageGarden from '@images/Moon Palace/garden.avif';
import travelImageHammock from '@images/Moon Palace/hammock.webp';
import travelImageLounge from '@images/Moon Palace/lounge.webp';
import travelImageRoom from '@images/Moon Palace/room.webp';
import travelImageThai from '@images/Moon Palace/thai.webp';
import sandBackground from '@images/temp-sand-background.png';

const RSVP_EMBED_URL = 'https://withjoy.com/arpit-rushita-cancun2027/rsvp';

const sectionBackdropStyle = (src: string, position = 'center') =>
  `background-image: url('${src}'); background-size: 100% 100%; background-position: ${position}; background-repeat: no-repeat; background-attachment: scroll;`;

const sectionNavItems = [
  { label: 'Home', href: '#v2-home' },
  { label: 'Travel & Accommodation', href: '#v2-travel' },
  { label: 'Schedule & Dress Code', href: '#v2-schedule' },
  { label: 'Things to do', href: '#v2-things-to-do' },
  { label: 'Our Story', href: '#v2-story' },
  { label: 'Q&A', href: '#v2-q-and-a' },
];

const events = [
  {
    date: '8th November 2027',
    title: 'Sangeet / Mendhi',
    label: 'Day 1',
    time: '6:00 PM - 10:00 PM',
    venue: 'Resort venue placeholder',
    dressCodeHeading: 'Sangeet & Mendhi Dress Code',
  },
  {
    date: '9th November 2027',
    title: 'Vidhi / Haldi',
    label: 'Day 2',
    time: '10:00 AM - 2:00 PM',
    venue: 'Resort venue placeholder',
    dressCodeHeading: 'Vidhi & Haldi Dress Code',
  },
  {
    date: '10th November 2027',
    title: 'Wedding Ceremony',
    label: 'Day 3',
    time: '4:00 PM - 10:00 PM',
    venue: 'Resort venue placeholder',
    dressCodeHeading: 'Wedding Ceremony Dress Code',
  },
  {
    date: '11th November 2027',
    title: 'Reception',
    label: 'Day 4',
    time: '7:00 PM - 11:00 PM',
    venue: 'Resort venue placeholder',
    dressCodeHeading: 'Reception Dress Code',
  },
];

const faqSections = [
  {
    title: 'Travel & Arrival',
    questions: [
      {
        question: 'Which airport should I fly into?',
        answer:
          'The nearest airport is Cancún International Airport (CUN), located approximately 15–20 minutes from Moon Palace.',
      },
      {
        question: 'How long does it take to get from the airport to the resort?',
        answer:
          'The transfer typically takes around 15 to 30 minutes depending on traffic and which section of Moon Palace you are heading to.',
      },
      {
        question: 'What flights are available from London, New York and India?',
        answerHtml: `
          <p><strong>London:</strong> Direct flights from London Gatwick (LGW) to Cancún (CUN) take approximately 10–11 hours; one-stop flights are also available from Heathrow and other UK airports.</p>
          <p><strong>New York:</strong> Direct flights from JFK and Newark (EWR) to Cancún (CUN) take approximately 4–5 hours.</p>
          <p><strong>India:</strong> There are no direct flights to Cancún. Most routes involve one or two connections, with total journey times typically ranging from 20–28 hours depending on your departure city and layovers.</p>
          <br/>
          <p>Helpful links:</p>
          <ul class="list-inside list-disc space-y-1">
            <li><a class="text-yellow-600 underline" href="https://www.google.com/travel/flights?gl=GB&hl=en-GB" target="_blank" rel="noopener noreferrer">Google Flights</a></li>
            <li><a class="text-yellow-600 underline" href="https://www.skyscanner.net/" target="_blank" rel="noopener noreferrer">Skyscanner</a></li>
            <li><a class="text-yellow-600 underline" href="https://www.expedia.co.uk/Flights?locale=en_GB&siteid=3" target="_blank" rel="noopener noreferrer">Expedia Flights</a></li>
          </ul>
        `,
      },
    ],
  },
  {
    title: 'Wedding Day Details',
    questions: [
      {
        question: 'What should I wear?',
        answer:
          'Each celebration has its own dress code. Please see the schedule section for guidance for each event.',
      },
      {
        question: 'Will all of the wedding events take place at Moon Palace?',
        answer:
          'Yes! All of our wedding events will take place within Moon Palace Cancún.',
      },
      {
        question: 'Can dietary requirements or allergies be accommodated?',
        answer:
          'Please let us know about any dietary requirements or allergies when you RSVP.',
      },
    ],
  },
  {
    title: 'Resort & Stay',
    questions: [
      {
        question: 'What amenities are included in the resort stay?',
        answerHtml: `
          <p>The resort offers beach access, multiple dining venues, bars, pools, activities, and entertainment throughout the property.</p>
          <p>For more information, download the Palace Resorts app: <a class="text-yellow-600 underline" href="https://apps.apple.com/us/app/palace-resorts/id1411599607" target="_blank" rel="noopener noreferrer">iOS</a> • <a class="text-yellow-600 underline" href="https://play.google.com/store/apps/details?id=com.palaceresorts.app&pli=1" target="_blank" rel="noopener noreferrer">Android</a>.</p>
        `,
      },
      {
        question: 'Is the resort all-inclusive?',
        answer:
          'Yes, the resort is designed as an all-inclusive destination, with many amenities and dining options covered in the stay package.',
      },
    ],
  },
];

const coupleMessage = `
  <div class="space-y-4 text-base leading-7 text-neutral-700">
    <p>
  We’re so excited to celebrate this next chapter with you in Mexico and can’t wait to share this unforgettable week with our loved ones.
</p>
<p>
  We want our celebration to be about more than just the wedding itself and we'd like our guests to have a memorable experience whilst also enjoying a nice getaway during what might otherwise be a colder and busier time of year.
</p>
<p>
  That’s why we chose Moon Palace in Cancun. We loved the idea of an all-inclusive setting where everyone can just arrive, drop their bags, and not have to worry about the daily logistics of finding meals or planning out activities. 
</p>
<p>
  Please explore the website for details on travel and what to expect. To make securing your accommodations as easy as possible, we’ve partnered with <b><i>Destawed</i></b> as our dedicated travel partner to manage our resort room block. Please visit the link below to explore your options and begin booking your stay. For any questions you have about travel arrangements, please review the Destawed page we've linked below and contact the Account Manager provided at the bottom of that page.
</p>
<p>
  We are so grateful for your love and support and can’t wait to see you in the sun in November 2027!
</p>
  </div>
`;
---

<MainLayout title="Wedding Website" hideNavbar={true}>
  <Navbar sectionLinks={sectionNavItems} />
  <div class="relative z-10 -mt-20">
    <section
      id="v2-home"
      class="w-full min-h-screen scroll-mt-[140px] pt-24"
    >
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
        <div class="w-full rounded-[32px] border border-white/50 bg-white/25 p-6 shadow-2xl shadow-black/10 backdrop-blur-xs sm:p-8 lg:p-10">
        <div class="flex items-center justify-center px-6 py-4 sm:px-8 lg:px-10">
          <img src={ganeshMotif.src} alt="Ganesh motif" class="h-16 w-auto object-contain sm:h-20 lg:h-24" />
        </div>

        <p class="text-center text-sm font-normal tracking-[0.3em] text-neutral-700/80 uppercase sm:text-base">
          We cordially invite you to the wedding of
        </p>
        <h1
          class="mt-4 text-center text-4xl font-normal tracking-[0.4em] text-balance text-neutral-800 md:text-5xl md:leading-tight dark:text-neutral-200"
          style="font-family: 'Cinzel', serif;"
        >
          Arpit
        </h1>
        <div class="flex items-center justify-center px-8 py-6 sm:px-8 sm:py-8 lg:px-10 lg:py-4">
          <img src={amp.src} alt="AMP" class="h-16 w-auto object-contain sm:h-20 lg:h-24" />
        </div>
        <h1
          class="text-center text-4xl font-normal tracking-[0.4em] text-balance text-neutral-800 md:text-5xl md:leading-tight dark:text-neutral-200"
          style="font-family: 'Cinzel', serif;"
        >
          Rushita
        </h1>

        <div class="mt-8 space-y-3 text-center">
          <p class="text-lg font-semibold tracking-[0.3em] text-neutral-700/80 uppercase">
            8-11th November, 2027
          </p>
          <p class="text-sm font-normal tracking-[0.3em] text-neutral-700/80 uppercase sm:text-sm">
            Moon Palace, Cancún, Quintana Roo, Mexico
          </p>
        </div>

        <div class="mt-8 flex justify-center">
          <Countdown targetDate="2027-11-08T00:00:00" />
        </div>

        <div class="mt-8 flex justify-center">
          <div data-rsvp-open class="cursor-pointer">
            <RSVPButton
              title="RSVP"
              url="#"
              fontClass="font-semibold text-base sm:text-base lg:text-4xl"
            />
          </div>
        </div>
      </div>
    </section>

    <section
      id="v2-travel"
      class="w-full scroll-mt-[140px]"
      style="background-color: #e5e5e5;"
    >
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
        <div class="text-center">
          <h2 class="text-2xl font-normal tracking-[0.1em] text-neutral-800 md:text-3xl" style="font-family: 'Cinzel', serif;">
            Travel & Accommodation
          </h2>
        </div>

        <div class="mt-8 mx-auto max-w-4xl overflow-hidden rounded-[28px] border border-white/70 bg-white/90 shadow-xl shadow-black/10">
          <div class="relative aspect-[16/9] overflow-hidden rounded-[26px]">
            <div class="carousel-track flex h-full transition-transform duration-700 ease-in-out">
              <img src={travelImageArielView.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageBeach.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageGarden.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageRoom.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageBalcony.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageHammock.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageAgra.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageAgra2.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageThai.src} class="h-full w-full shrink-0 object-cover" />
              <img src={travelImageLounge.src} class="h-full w-full shrink-0 object-cover" />
            </div>
          </div>
        </div>

        <div class="mt-8 space-y-6">
          <div>
            <h3 class="text-lg font-semibold text-neutral-900">A note from the couple</h3>
            <div class="mt-4" set:html={coupleMessage} />
          </div>

          <div class="mt-8 flex justify-center">
            <a
              href="https://www.destawed.com/couples/rushita-arpit"
              rel="noreferrer"
              class="inline-flex items-center justify-center rounded-full border border-[#D6AB3A] bg-white/90 px-6 py-3 text-center text-sm font-semibold text-[#D6AB3A] shadow-none backdrop-blur-sm transition duration-200 hover:border-white/20 hover:bg-white/50 hover:text-[#e0be63]"
            >
              Book Your Stay
            </a>
          </div>
        </div>
      </div>
    </section>

    <section
      id="v2-schedule"
      class="w-full scroll-mt-[140px]"
      style="background-color: #d4d4d4;"
    >
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
        <div class="text-center">
          <h2 class="text-2xl font-normal tracking-[0.1em] text-neutral-800 md:text-3xl" style="font-family: 'Cinzel', serif;">
            Schedule & Dress Code
          </h2>
        </div>
        <div class="relative mt-10">
          <div class="space-y-10">
            {events.map((event, index) => (
              <div class="relative flex flex-col gap-6 rounded-3xl border border-neutral-200 bg-white/90 p-6 shadow-sm md:flex-row md:items-start md:gap-8">
                <div class="md:w-[6rem]">
                  <div class="flex flex-col items-center gap-4">
                    <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[#D6AB3A] text-lg font-semibold text-white shadow-lg shadow-yellow-500/20">
                      <span>{event.label}</span>
                    </div>
                  </div>
                </div>

                <div class="w-full">
                  <p class="text-sm font-semibold uppercase tracking-[0.35em] text-yellow-600">{event.date}</p>
                  <h3 class="mt-3 text-2xl font-semibold text-neutral-900">{event.title}</h3>
                  <div class="mt-4 space-y-2 text-sm text-neutral-600">
                    <p class="font-semibold text-neutral-900">{event.time}</p>
                    <p>{event.venue}</p>
                  </div>
                  <button
                    type="button"
                    class="mt-6 inline-flex items-center justify-center rounded-full bg-yellow-500 px-5 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-yellow-600"
                    aria-expanded="false"
                    data-toggle={`dress-code-${index}`}
                  >
                    View Dress Code
                  </button>
                  <div id={`dress-code-${index}`} class="mt-6 hidden rounded-3xl border border-neutral-200 bg-neutral-50 p-6">
                    <p class="text-sm font-semibold uppercase tracking-[0.35em] text-neutral-500">{event.dressCodeHeading}</p>
                    <div class="mt-4 rounded-3xl bg-gradient-to-br from-yellow-100 via-white to-yellow-100 p-6">
                      <div class="flex h-full w-full flex-col items-center justify-center rounded-3xl border border-dashed border-yellow-300 bg-white/80 p-6 text-center shadow-sm">
                        <p class="text-lg font-semibold text-neutral-900">{event.dressCodeHeading}</p>
                        <p class="mt-3 text-sm leading-7 text-neutral-600">This preview image shows the suggested guest dress code for the celebration.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section
      id="v2-things-to-do"
      class="w-full scroll-mt-[140px]"
      style="background-color: #c0c0c0;"
    >
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
        <div class="text-center">
          <h2 class="text-2xl font-normal tracking-[0.1em] text-neutral-800 md:text-3xl" style="font-family: 'Cinzel', serif;">
            Things to do
          </h2>
        </div>

        <div class="mt-6 space-y-6 text-base leading-7 text-neutral-700">
          <p>
            <strong>Moon Palace Cancún</strong> is made up of three connected sections—<strong>Nizuc, Sunrise and The Grand</strong>—giving guests access to a wide selection of restaurants, pools, bars and activities throughout the property.
          </p>
          <p>
            Whether you're looking to unwind by the beach, spend time with family, or turn the trip into a holiday, there's plenty to enjoy during your stay.
          </p>

          <div>
            <h3 class="text-lg font-semibold">Things to Do</h3>
            <ul class="mt-3 space-y-2">
              <li>🏖️ Relax on the beach or by one of the many pools</li>
              <li>🍽️ Dine at over 20 restaurants and bars, including Indian cuisine</li>
              <li>💆 Visit the spa or play a round of golf*</li>
              <li>🎳 Enjoy the bowling alley, arcade, water park and sports facilities</li>
              <li>🎭 Watch live entertainment and evening shows</li>
              <li>💪 Make use of the fitness centre and daily activities</li>
              <li>🍹 Unwind with a cocktail at one of the many bars</li>
              <li>🌅 Take a stroll along the beachfront at sunset</li>
            </ul>
          </div>

          <div>
            <h3 class="text-lg font-semibold">Excursions</h3>
            <ul class="mt-3 space-y-2">
              <li>⛵ <strong>Isla Mujeres</strong> – A picturesque island known for its beaches, snorkelling and relaxed atmosphere.</li>
              <li>🏛️ <strong>Chichén Itzá</strong> – One of the New Seven Wonders of the World and Mexico's most famous Mayan archaeological site.</li>
              <li>💧 <strong>Cenotes</strong> – Natural freshwater sinkholes perfect for swimming and snorkelling.</li>
              <li>🐠 <strong>Snorkelling & Catamaran Tours</strong> – Explore the Caribbean Sea and nearby coral reefs.</li>
              <li>🌆 <strong>Cancún Hotel Zone</strong> – Visit local shops, restaurants and nightlife just a short drive away.</li>
            </ul>
            <p class="mt-3 text-sm italic">*Some resort activities and all excursions are available at an additional cost.</p>
          </div>

          <div class="mt-8 rounded-3xl border border-neutral-200/80 bg-neutral-50/80 p-5 text-base leading-7 text-neutral-700">
            <p class="font-semibold">Download the Palace Resorts app to view resort amenities, request services, book restaurants, and navigate the resort:</p>
            <div class="mt-4 flex w-full flex-col items-center gap-3 sm:flex-row sm:items-center sm:justify-center">
              <a href="https://apps.apple.com/us/app/palace-resorts/id1411599607" target="_blank" rel="noopener noreferrer" aria-label="Download on the App Store">
                <img src={appStoreBadge.src} alt="Download on the App Store" class="h-12 w-auto rounded-lg" />
              </a>
              <a href="https://play.google.com/store/apps/details?id=com.palaceresorts.app&pli=1" target="_blank" rel="noopener noreferrer" aria-label="Get it on Google Play">
                <img src={googlePlayBadge.src} alt="Get it on Google Play" class="h-12 w-auto rounded-lg" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="v2-story"
      class="w-full scroll-mt-[140px]"
      style="background-color: #f0f0f0;"
    >
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
        <div class="text-center">
          <h2 class="text-2xl font-normal tracking-[0.1em] text-neutral-800 md:text-3xl" style="font-family: 'Cinzel', serif;">
            Our Story
          </h2>
        </div>

        <div class="mt-8">
          <div class="mx-auto mb-6 max-w-3xl overflow-hidden rounded-[14px] border border-white/70 p-1 shadow-xl shadow-black/10 backdrop-blur-sm">
            <div class="relative aspect-[4/5] overflow-hidden rounded-[11px] sm:aspect-[4/5] md:aspect-auto md:h-[540px] lg:h-[540px]">
              <div class="carousel-track flex h-full transition-transform duration-700 ease-in-out">
                <img src={storyPic7.src} class="h-full w-full shrink-0 object-cover" />
                <img src={storyPic3.src} class="h-full w-full shrink-0 object-cover" />
                <img src={storyPic1.src} class="h-full w-full shrink-0 object-cover" />
                <img src={storyPic6.src} class="h-full w-full shrink-0 object-cover" />
                <img src={storyPic2.src} class="h-full w-full shrink-0 object-cover" />
                <img src={storyPic4.src} class="h-full w-full shrink-0 object-cover" />
                <img src={storyPic5.src} class="h-full w-full shrink-0 object-cover" />
                <img src={storyPic8.src} class="h-full w-full shrink-0 object-cover" />
                <img src={storyPic9.src} class="h-full w-full shrink-0 object-cover" />
              </div>
            </div>
          </div>

          <div class="space-y-4 text-base leading-8 text-neutral-700">
            <p>
              If you'd asked either of us in September 2024 whether we'd be
              planning a wedding, we'd probably have laughed… and then
              complained about online dating.
            </p>

            <p>
              Then, Arpit changed his Hinge location to London. We matched the
              very next day and immediately discovered a shared love for Mario
              Kart, long walks, and a highly competitive streak over table
              tennis (or ping pong, depending on who you ask—the debate is still
              ongoing). Just like us matching on Hinge, our meeting also felt
              serendipitous. Within a day of matching, an opportunity popped up
              for Arpit to travel to London for work and we set a date for
              November 2024.
            </p>

            <p>
              Our first date at Zizzi proved we got along just as well in
              person, and countless flights and a trip to Paris later, things
              became official. We navigated the time difference with long video
              calls and daily commutes spent playing our favorite puzzle game,
              Squaredle. Fast forward to November 2025: during a romantic horse
              and carriage ride through Windsor, Arpit proposed using a custom
              version of Squaredle he built just for the occasion to reveal a
              special message when Rushita opened it - "Rushi, will you marry
              me?"
            </p>

            <p>
              The 2 possible answers were "Yes or Absolutely Yes." Thankfully,
              Rushita chose correctly!
            </p>

            <p>
              November has always been our milestone month, so it only felt
              right to celebrate our Indian wedding then, too—this time
              somewhere a lot warmer. We can't wait to make even more memories
              with you all in Mexico!
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="v2-q-and-a"
      class="w-full scroll-mt-[140px]"
      style="background-color: #a3a3a3;"
    >
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
        <div class="text-center">
          <h2 class="text-2xl font-normal tracking-[0.1em] text-neutral-800 md:text-3xl" style="font-family: 'Cinzel', serif;">
            Q&A
          </h2>
        </div>

        <div class="mt-6 space-y-6">
          {faqSections.map((section) => (
            <div class="rounded-2xl border border-neutral-200/80 bg-white/70 p-4 shadow-sm sm:p-5">
              <h3 class="text-lg font-semibold text-neutral-800">{section.title}</h3>
              <div class="mt-4 space-y-3">
                {section.questions.map((item) => (
                  <details class="rounded-xl border border-neutral-200 bg-white/90 px-4 py-3 shadow-sm">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-neutral-800">
                      <span>{item.question}</span>
                      <span class="shrink-0 rounded-full bg-neutral-100 px-2 py-1 text-xs text-neutral-600">+</span>
                    </summary>
                    {item.answerHtml ? (
                      <div class="pt-3 text-sm leading-6 text-neutral-700" set:html={item.answerHtml}></div>
                    ) : (
                      <div class="pt-3 text-sm leading-6 text-neutral-700">{item.answer}</div>
                    )}
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <div data-rsvp-modal class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/50 p-0 lg:p-4">
    <div class="relative h-full w-full overflow-hidden bg-white shadow-2xl lg:h-[80vh] lg:w-[50vw] lg:rounded-2xl">
      <button
        type="button"
        data-rsvp-close
        class="absolute top-3 right-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-xl text-neutral-800 shadow-sm"
        aria-label="Close RSVP dialog"
      >
        ×
      </button>
      <iframe
        src={RSVP_EMBED_URL}
        title="RSVP form"
        class="h-full w-full overflow-hidden border-0"
        style="scrollbar-width: none; -ms-overflow-style: none; overflow: hidden;"
      ></iframe>
    </div>
  </div>

  <script>
    const openButton = document.querySelector('[data-rsvp-open]');
    const closeButton = document.querySelector('[data-rsvp-close]');
    const modal = document.querySelector('[data-rsvp-modal]');

    if (openButton && closeButton && modal) {
      const openModal = (event: MouseEvent) => {
        event.preventDefault();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      };

      const closeModal = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      openButton.addEventListener('click', event => openModal(event as MouseEvent));
      closeButton.addEventListener('click', closeModal);
      modal.addEventListener('click', event => {
        if (event.target === modal) closeModal();
      });
    }

    const toggleButtons = document.querySelectorAll('[data-toggle]');
    toggleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-toggle');
        if (!targetId) return;
        const panel = document.getElementById(targetId);
        if (!panel) return;
        const isHidden = panel.classList.toggle('hidden');
        button.setAttribute('aria-expanded', String(!isHidden));
        button.textContent = isHidden ? 'View Dress Code' : 'Hide Dress Code';
      });
    });

    const carousels = document.querySelectorAll('.carousel-track');
    carousels.forEach((track) => {
      const slides = Array.from(track.children);
      if (!slides.length) return;
      let currentIndex = 0;
      const showSlide = (index: number) => {
        const offset = index * -100;
        track.setAttribute('style', `transform: translateX(${offset}%);`);
      };
      const nextSlide = () => {
        currentIndex = (currentIndex + 1) % slides.length;
        showSlide(currentIndex);
      };
      setInterval(nextSlide, 5000);
      showSlide(0);
    });
  </script>
  <style set:html={`
    #v2-home {
      background-image: url('${weddingThemeBackground.src}');
      background-size: 100% 100%;
      background-position: center bottom;
      background-repeat: no-repeat;
      background-attachment: scroll;
    }
    @media (max-width: 639px) {
      #v2-home {
        background-image: url('${mobileBackground.src}') !important;
      }
    }
  `}></style>
</MainLayout>
