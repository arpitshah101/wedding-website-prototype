  <div data-rsvp-modal class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/50 p-0 lg:p-4">
    <div class="relative h-full w-full overflow-hidden bg-white shadow-2xl lg:h-[80vh] lg:w-[50vw] lg:rounded-2xl">
      <button
        type="button"
        data-rsvp-close
        class="absolute top-3 right-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-xl text-neutral-800 shadow-sm"
        aria-label="Close RSVP dialog"
      >
        ×
      </button>
      <iframe
        src={RSVP_EMBED_URL}
        title="RSVP form"
        class="h-full w-full overflow-hidden border-0"
        style="scrollbar-width: none; -ms-overflow-style: none; overflow: hidden;"
      ></iframe>
    </div>
  </div>

  <script>
    const openButton = document.querySelector('[data-rsvp-open]');
    const closeButton = document.querySelector('[data-rsvp-close]');
    const modal = document.querySelector('[data-rsvp-modal]');

    if (openButton && closeButton && modal) {
      const openModal = (event: MouseEvent) => {
        event.preventDefault();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      };

      const closeModal = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      openButton.addEventListener('click', event => openModal(event as MouseEvent));
      closeButton.addEventListener('click', closeModal);
      modal.addEventListener('click', event => {
        if (event.target === modal) closeModal();
      });
    }

    const toggleButtons = document.querySelectorAll('[data-toggle]');
    toggleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-toggle');
        if (!targetId) return;
        const panel = document.getElementById(targetId);
        if (!panel) return;
        const isHidden = panel.classList.toggle('hidden');
        button.setAttribute('aria-expanded', String(!isHidden));
        button.textContent = isHidden ? 'View Dress Code' : 'Hide Dress Code';
      });
    });

    const searchInput = document.querySelector('#faq-search');
    const clearButton = document.querySelector('#faq-clear');
    const sections = Array.from(document.querySelectorAll('[data-section]'));
    const emptyState = document.querySelector('#faq-empty-state');

    const applySearch = (query: string) => {
      let anyVisible = false;

      sections.forEach((section) => {
        const sectionContainer = section.closest('.rounded-2xl');
        const sectionTitle = (sectionContainer as HTMLElement | null)?.dataset.sectionTitle ?? '';
        let sectionVisible = false;
        const items = Array.from(section.querySelectorAll('.faq-item'));

        items.forEach((item) => {
          const text = (item as HTMLElement).dataset.query ?? '';
          const shouldShow = !query || sectionTitle.includes(query) || text.includes(query);
          item.classList.toggle('hidden', !shouldShow);
          if (shouldShow) sectionVisible = true;
        });

        sectionContainer?.classList.toggle('hidden', !sectionVisible);
        if (sectionVisible) anyVisible = true;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', anyVisible);
      }
    };

    if (searchInput) {
      searchInput.addEventListener('input', (event) => {
        const query = (event.currentTarget as HTMLInputElement).value.trim().toLowerCase();
        applySearch(query);
      });

      clearButton?.addEventListener('click', () => {
        if (searchInput instanceof HTMLInputElement) {
          searchInput.value = '';
          applySearch('');
          searchInput.focus();
        }
      });
    }

    const carousels = document.querySelectorAll('.carousel-track');
    carousels.forEach((track) => {
      const slides = Array.from(track.children);
      if (!slides.length) return;
      let currentIndex = 0;
      const showSlide = (index: number) => {
        const offset = index * -100;
        track.setAttribute('style', `transform: translateX(${offset}%);`);
      };
      const nextSlide = () => {
        currentIndex = (currentIndex + 1) % slides.length;
        showSlide(currentIndex);
      };
      setInterval(nextSlide, 5000);
      showSlide(0);
    });
  </script>
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    gsap.from('#v2-travel-content', {
      autoAlpha: 0,
      y: 50,
      duration: 1,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#v2-travel-content',
        start: 'top 80%',
        once: true,
      },
    });

    import { animate } from 'animejs';
    {
      const ganesh = document.getElementById('intro-ganesh');
      const line1 = document.getElementById('v2-text-line1');
      const line2 = document.getElementById('v2-text-line2');
      const line3 = document.getElementById('v2-text-line3');
      const watercolor = document.getElementById('v2-watercolor');
      const details = document.getElementById('v2-details');
      if (ganesh && line1 && line2 && line3 && watercolor && details) {
        const gRect = ganesh.getBoundingClientRect();
        const ganeshCenter = gRect.top + gRect.height / 2;
        const viewportCenter = window.innerHeight / 2;
        const centerOffset = viewportCenter - ganeshCenter;
        ganesh.style.transform = `translateY(${centerOffset}px)`;
        ganesh.style.opacity = '1';
        ganesh.style.willChange = 'transform';
        animate(ganesh, {
          translateY: { from: centerOffset, to: 0 },
          duration: 3200,
          ease: 'outCubic',
          complete: () => {
            ganesh.style.willChange = '';
          },
        });
        setTimeout(() => {
          animate(line1, { opacity: { from: 0, to: 1 }, duration: 1000, ease: 'outCubic' });
        }, 3400);
        setTimeout(() => {
          animate(line2, { opacity: { from: 0, to: 1 }, duration: 1000, ease: 'outCubic' });
          animate(line3, { opacity: { from: 0, to: 1 }, duration: 1000, ease: 'outCubic' });
        }, 4600);
        setTimeout(() => {
          animate(watercolor, { opacity: { from: 0, to: 1 }, duration: 1200, ease: 'outCubic' });
        }, 5800);
        setTimeout(() => {
          animate(details, { opacity: { from: 0, to: 1 }, duration: 1200, ease: 'outCubic' });
        }, 7200);
      }
    }
  </script>
  <script>
    const toggle = document.getElementById('nav-toggle');
    const links = document.getElementById('nav-links');
    const iconOpen = document.getElementById('nav-icon-open');
    const iconClose = document.getElementById('nav-icon-close');
    if (toggle && links) {
      toggle.addEventListener('click', () => {
        links.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
      });
      links.querySelectorAll('[data-section-link]').forEach((link) => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 640) {
            links.classList.add('hidden');
            iconOpen?.classList.remove('hidden');
            iconClose?.classList.add('hidden');
          }
        });
      });
    }
  </script>
