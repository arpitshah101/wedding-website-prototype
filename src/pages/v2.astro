      --fade-end: 100%;
      mask-image: radial-gradient(ellipse var(--fade-width) var(--fade-height) at center, black var(--fade-start), transparent var(--fade-end));
      -webkit-mask-image: radial-gradient(ellipse var(--fade-width) var(--fade-height) at center, black var(--fade-start), transparent var(--fade-end));
